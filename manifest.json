{
  "manifest_version": 3,
  "name": "텍스트그랩 — 영역 텍스트 추출",
  "version": "1.0.0",
  "description": "웹페이지에서 영역이나 요소를 선택해 그 안의 텍스트를 그대로 추출·복사·저장합니다. DataForge 제공.",
  "permissions": ["activeTab", "scripting"],
  "action": {
    "default_popup": "popup.html",
    "default_title": "텍스트그랩 — 영역 텍스트 추출",
    "default_icon": {
      "16": "icons/icon16.png",
      "32": "icons/icon32.png",
      "48": "icons/icon48.png",
      "128": "icons/icon128.png"
    }
  },
  "icons": {
    "16": "icons/icon16.png",
    "32": "icons/icon32.png",
    "48": "icons/icon48.png",
    "128": "icons/icon128.png"
  }
}
